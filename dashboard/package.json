{
  "name": "traffic-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "AI Traffic Control dashboard — Node/TypeScript server + Three.js 3D intersection view",
  "scripts": {
    "dev": "concurrently -n vite,server -c blue,green \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build",
    "start": "npm run build && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "express": "^4.19.2",
    "three": "^0.166.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/three": "^0.166.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
